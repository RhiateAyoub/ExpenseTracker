<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_add_expense.xml -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- HEADER SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bonjour Ayoub 👋"
                    android:textSize="24sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/black"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29 Novembre 2025"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_dark"
                    android:layout_marginTop="6dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- FORM CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@color/white">

                    <!-- TITLE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ajouter une dépense"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="24dp"/>

                    <!-- PRIX (Price) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prix"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="20dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="@color/line_gray">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Value"
                            android:inputType="numberDecimal"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray_dark"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- CATÉGORIE (Category) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Catégorie"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/categoryInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="@color/line_gray"
                        app:endIconMode="dropdown_menu"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                        <AutoCompleteTextView
                            android:id="@+id/actvCategory"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:hint="Sélectionner"
                            android:inputType="none"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray_dark"
                            android:drawablePadding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- DATE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginBottom="20dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="@color/line_gray"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconScaleType="centerInside">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Value"
                            android:focusable="false"
                            android:clickable="true"
                            android:inputType="none"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray_dark"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- NOTE -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Note"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxStrokeColor="@color/line_gray">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Value"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:maxLines="5"
                            android:gravity="top|start"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_regular"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray_dark"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- AJOUTER BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddExpense"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Ajouter"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="8dp"
                        android:elevation="0dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>