<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_home.xml - FIXED VERSION -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="80dp">

            <!-- HEADER SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bonjour Ayoub 👋"
                    android:textSize="24sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/black"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="29 Novembre 2025"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_dark"
                    android:layout_marginTop="6dp"
                    android:gravity="center"/>

                <!-- Divider Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_gray"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"/>
            </LinearLayout>

            <!-- État 1: NO BUDGET (orange) -->
            <LinearLayout
                android:id="@+id/noBudgetSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNoBudgetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aucun budget"
                    android:textColor="#FF9800"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvNoBudgetMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Définissez un budget pour ce mois"
                    android:textColor="#FF9800"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- POSITIVE MESSAGE SECTION -->
            <LinearLayout
                android:id="@+id/positiveSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/tvPositiveTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bravo !"
                    android:textColor="@color/primary_green"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter_semibold"/>

                <TextView
                    android:id="@+id/tvPositiveMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vous êtes sur la bonne voie ce mois-ci 🎉"
                    android:textColor="@color/primary_green"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- NEGATIVE MESSAGE SECTION (Hidden by default) -->
            <LinearLayout
                android:id="@+id/negativeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNegativeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attention :"
                    android:textColor="@color/red_strong"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter_semibold"/>

                <TextView
                    android:id="@+id/tvNegativeMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vos dépenses dépassent votre budget prévu."
                    android:textColor="@color/red_strong"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter_regular"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- CARDS SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="60dp"
                android:paddingEnd="60dp"
                android:paddingTop="0dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:clipChildren="false">

                <include layout="@layout/home_card_expenses_month"/>
                <include layout="@layout/home_card_expensive_category"/>
                <include layout="@layout/home_card_balance"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button - Fixed at bottom right -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp"
        android:src="@drawable/ic_add"
        app:tint="@color/white"
        app:backgroundTint="@color/primary"
        app:elevation="6dp"
        app:borderWidth="0dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>