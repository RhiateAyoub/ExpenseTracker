<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    tools:context=".ui.statistics.StatisticsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Section for Month Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="32dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="24dp">

            <ImageButton
                android:id="@+id/btnPreviousMonth"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chevron_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mois précédent" />

            <TextView
                android:id="@+id/tvSelectedMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Novembre 2025"
                android:textSize="22sp"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/black"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_chevron_right"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mois suivant" />
        </LinearLayout>

        <!-- This FrameLayout allows stacking the data state and empty state -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Data State: Contains Pie Chart and RecyclerView -->
            <LinearLayout
                android:id="@+id/dataState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Pie Chart -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginTop="16dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/line_gray"
                    android:layout_marginTop="24dp"
                    android:layout_marginHorizontal="24dp"/>

                <!-- RecyclerView for Category Stats -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategoryStats"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingBottom="80dp"
                    android:clipToPadding="false"
                    tools:listitem="@layout/item_category_stat"/>
            </LinearLayout>

            <!-- Empty State: Shown when there is no data -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="60dp"
                android:visibility="visible"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_stats"
                    app:tint="@color/line_gray"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aucune donnée"
                    android:textSize="18sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/gray_dark"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ajoutez des dépenses pour voir les statistiques."
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_dark"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddExpense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp"
        android:src="@drawable/ic_add"
        app:tint="@color/white"
        app:backgroundTint="@color/primary"
        app:elevation="6dp"
        app:borderWidth="0dp"
        android:contentDescription="Ajouter une dépense"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
