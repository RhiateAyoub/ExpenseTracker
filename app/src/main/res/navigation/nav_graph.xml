<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home Fragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.expensetracker.ui.home.HomeFragment"
        android:label="Accueil"
        tools:layout="@layout/fragment_home" />

    <!-- Expenses Fragment -->
    <fragment
        android:id="@+id/expensesFragment"
        android:name="com.example.expensetracker.ui.expenses.ExpenseFragment"
        android:label="Dépenses"
        tools:layout="@layout/fragment_expenses">

        <!-- Action to navigate to Add Expense -->
        <action
            android:id="@+id/action_expenses_to_addExpense"
            app:destination="@id/addExpenseFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Add Expense Fragment -->
    <fragment
        android:id="@+id/addExpenseFragment"
        android:name="com.example.expensetracker.ui.expenses.AddExpenseFragment"
        android:label="Ajouter une dépense"
        tools:layout="@layout/fragment_add_expense" />

    <!-- Monthly History Fragment -->
    <fragment
        android:id="@+id/monthlyHistoryFragment"
        android:name="com.example.expensetracker.ui.budget.MonthlyHistoryFragment"
        android:label="Historique mensuel"
        tools:layout="@layout/fragment_monthly_history" />

    <!-- Update Budget Fragment to add action -->
    <fragment
        android:id="@+id/budgetFragment"
        android:name="com.example.expensetracker.ui.budget.BudgetFragment"
        android:label="Budget"
        tools:layout="@layout/fragment_budget">

        <!-- Add this action -->
        <action
            android:id="@+id/action_budget_to_monthlyHistory"
            app:destination="@id/monthlyHistoryFragment" />
    </fragment>

    <!-- Statistics Fragment (placeholder)
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.expensetracker.ui.statistics.StatisticsFragment"
        android:label="Stats" />
-->
</navigation>